{
  "name": "lz4-kafkajs",
  "version": "2.0.2",
  "description": "LZ4 compression codec for KafkaJS",
  "author": "Marvin Pöperny",
  "keywords": [
    "kafka",
    "kafkajs",
    "compression",
    "lz4",
    "codec",
    "typescript"
  ],
  "homepage": "https://github.com/paister/lz4-kafkajs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paister/lz4-kafkajs.git"
  },
  "bugs": {
    "url": "https://github.com/paister/lz4-kafkajs/issues"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "kafkajs": "^2.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "tsc && node --test dist/test/lz4-compression.test.js",
    "test:integration": "tsc && node --test dist/integration/kafka-roundtrip.integration.js",
    "kafka:up": "docker compose up --detach --wait",
    "kafka:down": "docker compose down",
    "prepack": "tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^18.19.130",
    "kafkajs": "^2.2.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lz4-napi": "^2.10.0"
  }
}
