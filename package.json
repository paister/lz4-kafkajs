{
  "name": "lz4-kafkajs",
  "version": "2.0.0",
  "description": "LZ4 streaming compression and decompression library for KafkaJS",
  "author": "Marvin Pöperny",
  "keywords": [
    "kafka",
    "kafkajs",
    "compression",
    "decompression",
    "lz4",
    "codec"
  ],
  "homepage": "http://github.com/paister/lz4-kafkajs",
  "repository": {
    "type": "git",
    "url": "git://github.com/paister/lz4-kafkajs.git"
  },
  "bugs": {
    "url": "http://github.com/paister/lz4-kafkajs/issues"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
